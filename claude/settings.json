{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "0.25"
  },
  "permissions": {
    "deny": [
      "Bash(curl:*)"
    ],
    "ask": [
      "Edit(~/.claude/settings.json)",
      "Edit(~/dotfiles/claude/settings.json)",
      "Edit(~/go/src/github.com/maguroguma/dotfiles/claude/settings.json)",
      "Edit(~/.claude/settings.local.json)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/yokoyamamasahiro/go/src/github.com/maguroguma/ai-notes"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/scripts/ai-notes-path.sh --hook"
          },
          {
            "type": "command",
            "command": "bash ~/dotfiles/scripts/claude-last-response.sh --clear"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.tool_input.command) - \\(.tool_input.description // \"No description\")\"' >> ~/.claude/any-command-history.log"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r 'if .tool_input.command | test(\"rm -rf|dd if=|:(){ :|:& };:\") then {\"decision\": \"block\", \"reason\": \"危険なコマンドは実行できません。別の方法を検討してください。\"} else empty end'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/scripts/claude-last-response.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date)] $USER: $(jq -r '.tool_input.command')\" >> ~/.claude/bash-command-history.log"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "outputStyle": "My Original",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "custom:pink-prompt",
  "wheelScrollAccelerationEnabled": false,
  "agentPushNotifEnabled": false
}
